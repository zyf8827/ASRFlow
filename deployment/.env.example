# ASRFlow Compose 环境变量模板
# 复制为 deployment/.env 后按需修改, 或运行 bash deployment/init-compose.sh 生成.
# docker compose 会自动读取本目录 .env. 真实 .env 不入库.

# ---- 部署 ----
ASRFLOW_MODE='single'          # single | multi
ASRFLOW_N_INST='1'
ASRFLOW_CORES_PER='0'          # 0=容器内全部核; 多实例须等于 cpuset 宽度
ASRFLOW_RESERVE='0'
ASRFLOW_VERSION='1.0.0'        # 镜像 asrflow:<版本>
ASRFLOW_MEM_LIMIT='2g'         # 容器内存上限 (mem_limit), init-compose.sh 交互设置; 改本行即生效, 不必重新生成
ASRFLOW_MOUNT_SOURCE='false'   # true = 生成的 compose 把仓库根挂到 /app (源码热替换); 仅 init-compose.sh 使用, compose 本身不读
ASRFLOW_LOG_BASE='/var/log/asrflow' # 宿主日志基目录, compose 挂载插值使用; 多实例为 <基目录>/instance-N

# ---- 服务 ----
ASR_DEVICE='cpu'
ASR_SERVER_PORT='10095'
ASR_HTTP_PORT='10096'
STREAMING_ASR_BACKEND='onnx'
VAD_BACKEND='funasr'
SPEAKER_BACKEND='funasr'
FINAL_ASR_BACKEND='vllm_http'
STREAMING_BATCH_SIZE='8'
STREAMING_BATCH_WINDOW_MS='15'
STREAMING_ONNX_QUANT='true'
STREAMING_ONNX_THREADS='0'
# OMP_NUM_THREADS='4'
# MKL_NUM_THREADS='4'
VAD_MAX_SPEECH_MS='30000'
LOG_LEVEL='INFO'

# ---- 二遍 vLLM ----
# 单实例(bridge): host.docker.internal; 多实例(host 网络): 127.0.0.1
# 独立编排参考 docker-compose.qwen3-asr.gpu / .ascend .example.yaml (镜像先构建: bash deployment/build-vllm.sh [gpu|ascend]),
# VLLM_URL 端口与 FINAL_ASR_MODEL 须与该文件的 ports / --served-model-name 一致
VLLM_URL='http://host.docker.internal:8899/v1/audio/transcriptions'
FINAL_ASR_MODEL='qwen3-asr-1.7b'

# ---- Nacos ----
NACOS_ENABLE='false'
NACOS_SERVER_ENDPOINT='127.0.0.1:8848'
NACOS_SERVICE_NAME='asrflow'
NACOS_SERVICE_HOST='127.0.0.1'
NACOS_NAMESPACE='public'
NACOS_GROUP_NAME='DEFAULT_GROUP'
NACOS_USERNAME='nacos'
NACOS_PASSWORD='CHANGE_ME'
NACOS_HEARTBEAT_SEC='5'

# ---- 多实例绑核 (init-compose.sh 按 nproc 生成; 核数须与 ONNX_THREADS 一致) ----
# ASRFLOW_1_CPUSET='0-3'
# ASRFLOW_1_ONNX_THREADS='4'
# ASRFLOW_2_CPUSET='4-7'
# ASRFLOW_2_ONNX_THREADS='4'
# ASRFLOW_3_CPUSET='8-11'
# ASRFLOW_3_ONNX_THREADS='4'
# ASRFLOW_4_CPUSET='12-15'
# ASRFLOW_4_ONNX_THREADS='4'
